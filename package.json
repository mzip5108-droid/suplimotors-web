{
  "name": "supli-motors-web",
  "version": "1.0.0",
  "private": true,
  "description": "Catalogo y gestion de repuestos Supli Motors - JS vanilla (modulos ES) + Supabase",
  "type": "module",
  "scripts": {
    "dev": "node tools/servidor-dev.cjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"js/**/*.js\"",
    "format:check": "prettier --check \"js/**/*.js\"",
    "verificar:imports": "node tools/verificar-imports.cjs",
    "test": "node tests/todo.test.js",
    "verify": "npm run lint && npm run verificar:imports && npm test"
  },
  "devDependencies": {
    "eslint": "^9.15.0",
    "espree": "^10.4.0",
    "globals": "^15.12.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.3.3"
  }
}
